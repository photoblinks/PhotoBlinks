NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ==========================================
# AUTH (Phase 19 — Resend email delivery + Google Sign-In)
# ==========================================
# RESEND_API_KEY is only used via the hosted Supabase project's own SMTP
# Settings dashboard (Authentication > Emails), never read by this app's
# code — server-only, never NEXT_PUBLIC_. Required locally only if you
# uncomment [auth.email.smtp] in supabase/config.toml to test real Resend
# delivery instead of the default local Inbucket catcher.
RESEND_API_KEY=

# Only needed locally if you flip [auth.external.google].enabled to true
# in supabase/config.toml to test Google Sign-In against a real Google
# Cloud OAuth client. The hosted project's Google credentials are
# configured separately in the Supabase Dashboard, not from this file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ==========================================
# CLOUDFLARE R2 (real bucket — no local/mock version)
# ==========================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Public URL images are served from (R2.dev subdomain or your custom domain)
R2_PUBLIC_URL=

# R2 custom domain connected to the bucket, with Cloudflare Image
# Transformations enabled — src/lib/cf-image-loader.ts rewrites every
# next/image request to this host instead of Vercel's image optimizer.
# NEXT_PUBLIC_ because the loader also runs in the browser; the hostname
# itself isn't secret (it's part of every optimized image URL the client
# already sees). Defaults to images.photoblinks.com in code if unset.
NEXT_PUBLIC_R2_IMAGE_DOMAIN=images.photoblinks.com

# ==========================================
# SCHEDULED JOBS (server-only)
# ==========================================
# Shared secret for triggering /api/admin/r2-orphan-sweep from a scheduler
# (Vercel Cron or equivalent) as `Authorization: Bearer <CRON_SECRET>`.
# Never NEXT_PUBLIC_. Optional locally — if unset, only an authenticated
# admin session can trigger the sweep.
CRON_SECRET=

# ==========================================
# MAPBOX
# ==========================================

NEXT_PUBLIC_MAPBOX_TOKEN=

# ==========================================
# APPLICATION
# ==========================================

NEXT_PUBLIC_SITE_URL=https://photoblinks.com

# ==========================================
# DATABASE (local Docker stack, direct connection — used only for running
# migration scripts, never at runtime)
# ==========================================

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
