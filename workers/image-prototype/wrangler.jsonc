{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photoblinks-image-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "photoblinks-images-test"
    }
  ]
}
